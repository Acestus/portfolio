    },
    {
      "route": "/fabric",
      "rewrite": "/fabric.html"
    },
    {
      "route": "/policy",
      "rewrite": "/policy.html"
    },
    {
      "route": "/logs",
      "rewrite": "/logs.html"
    },
    {
      "route": "/iac",
      "rewrite": "/iac.html"
    },
    {
      "route": "/platform",
      "rewrite": "/platform.html"
    },
    {
      "route": "/repl",
